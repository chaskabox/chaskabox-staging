# ChaskaBox final FREE-AI deployment candidate — environment template
# Never commit real secrets. Configure these in Cloudflare/Supabase deployment settings.

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key

# Deployment mode + Cloudflare Turnstile (server only)
ENVIRONMENT=staging
REQUIRE_TURNSTILE=true
TURNSTILE_SECRET_KEY=server-only-turnstile-secret

# Owner notifications (optional email)
OWNER_ORDER_EMAIL=owner@example.com
RESEND_API_KEY=server-only-resend-key
RESEND_FROM_EMAIL=orders@your-domain.com

# WAHA WhatsApp (self-hosted; server only)
WAHA_API_URL=https://your-waha-host.example.com
WAHA_API_KEY=server-only-waha-key
WAHA_SESSION=default
OWNER_WHATSAPP=923000000000

# Public/site URLs
PUBLIC_BASE_URL=https://your-domain.com
ADMIN_BASE_URL=https://your-domain.com

# Optional privacy-first UX analytics
CLARITY_PROJECT_ID=

# Distributed rate limiting
RATE_LIMIT_CAPACITY=10
RATE_LIMIT_PER_MINUTE=10
ADMIN_RATE_LIMIT_CAPACITY=30
ADMIN_RATE_LIMIT_PER_MINUTE=30

# Notification outbox worker authentication / scheduling
OUTBOX_RUN_SECRET=server-only-random-secret

# FREE AI
# IMPORTANT: configure a Cloudflare Pages Workers AI BINDING named `AI`.
# No AI API key is required by this candidate.
# Optional non-secret model overrides; omit to use code defaults:
AI_TEXT_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
AI_EMBEDDING_MODEL=@cf/qwen/qwen3-embedding-0.6b
