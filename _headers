/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https://*.supabase.co https://formsubmit.co; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://formsubmit.co

/products.json
  Cache-Control: public, max-age=300

/images/*
  Cache-Control: public, max-age=86400

/app.js
  Cache-Control: public, max-age=3600

/account.js
  Cache-Control: public, max-age=3600

/retention.js
  Cache-Control: public, max-age=3600

/checkout.js
  Cache-Control: public, max-age=3600

/styles.css
  Cache-Control: public, max-age=3600

/admin.html
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

/checkout.html
  Cache-Control: no-store
  X-Robots-Tag: noindex, follow

/admin.js
  Cache-Control: no-store

/admin.css
  Cache-Control: no-store
