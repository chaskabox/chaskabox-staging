/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://challenges.cloudflare.com https://www.clarity.ms; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://*.supabase.co https://challenges.cloudflare.com https://*.clarity.ms https://c.bing.com; frame-src https://challenges.cloudflare.com; form-action 'self'; upgrade-insecure-requests

/products.json
  Cache-Control: public, max-age=300, stale-while-revalidate=600

/images/*
  Cache-Control: public, max-age=86400, immutable

/app.js
  Cache-Control: public, max-age=3600

/account.js
  Cache-Control: public, max-age=3600

/analytics.js
  Cache-Control: public, max-age=3600

/retention.js
  Cache-Control: public, max-age=3600

/checkout.js
  Cache-Control: public, max-age=3600

/admin.html
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

/checkout.html
  Cache-Control: no-store
  X-Robots-Tag: noindex, follow

/track-order.html
  Cache-Control: no-store
  X-Robots-Tag: noindex, follow

/admin.js
  Cache-Control: no-store

/admin-live.js
  Cache-Control: no-store

/admin.css
  Cache-Control: no-store

/product-runtime.js
  Cache-Control: public, max-age=300
